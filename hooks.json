{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 -B \"${PLUGIN_ROOT}/gates/session_guard.py\" session-start",
        "powershell": "python -B \"${PLUGIN_ROOT}\\gates\\session_guard.py\" session-start",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "^(?:functions\\.)?(view|read_file|glob|grep|rg|web_fetch|web_search|semantic_code_search)$",
        "bash": "python3 -B \"${PLUGIN_ROOT}/gates/session_guard.py\" post-tool-use",
        "powershell": "python -B \"${PLUGIN_ROOT}\\gates\\session_guard.py\" post-tool-use",
        "timeoutSec": 5
      }
    ]
  }
}
