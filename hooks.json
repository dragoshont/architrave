{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 -B \"${PLUGIN_ROOT}/gates/session_guard.py\" session-start",
        "powershell": "python -B \"${PLUGIN_ROOT}\\gates\\session_guard.py\" session-start",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "^task_complete$",
        "bash": "python3 -B \"${PLUGIN_ROOT}/gates/session_guard.py\" pre-tool-use",
        "powershell": "python -B \"${PLUGIN_ROOT}\\gates\\session_guard.py\" pre-tool-use",
        "timeoutSec": 30
      }
    ]
  }
}
