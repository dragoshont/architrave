{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://architrave/benchmarks/scenarios.schema.json",
  "title": "Architrave benchmark scenarios",
  "type": "object",
  "required": ["version", "arms", "scenarios"],
  "additionalProperties": false,
  "definitions": {
    "executionIntent": {
      "type": "object",
      "required": ["modelClass", "reasoning", "context", "verification"],
      "additionalProperties": false,
      "properties": {
        "profile": { "type": ["string", "null"], "enum": [null, "FAST", "BALANCED", "DEEP", "CRITICAL"] },
        "modelClass": { "type": "string", "enum": ["inherit", "fast", "default", "strong"] },
        "reasoning": { "type": "string", "enum": ["low", "default", "high", "max"] },
        "context": { "type": "string", "enum": ["narrow", "default", "long"] },
        "verification": { "type": "string", "enum": ["default", "independent", "cross-family"] }
      }
    }
  },
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "runner"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "enabled": { "type": "boolean" },
          "runner": { "type": "string", "enum": ["copilot", "claude", "codex", "shell"] },
          "agent": { "type": "string" },
          "model": { "type": "string" },
          "reasoningEffort": { "type": "string", "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
          "contextTier": { "type": "string", "enum": ["default", "long_context"] },
          "execution": { "$ref": "#/definitions/executionIntent" },
          "customInstructions": { "type": "boolean" },
          "allowAll": { "type": "boolean" },
          "noAskUser": { "type": "boolean" },
          "pluginDir": { "type": "string" },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "env": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "allOf": [
          {
            "if": { "required": ["runner"], "properties": { "runner": { "const": "copilot" } } },
            "then": { "not": { "required": ["command"] } }
          },
          {
            "if": { "required": ["runner"], "properties": { "runner": { "const": "claude" } } },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["command"] },
                  { "required": ["agent"] },
                  { "required": ["reasoningEffort"] },
                  { "required": ["contextTier"] },
                  { "required": ["customInstructions"] },
                  { "required": ["allowAll"] },
                  { "required": ["noAskUser"] },
                  { "required": ["pluginDir"] }
                ]
              }
            }
          },
          {
            "if": { "required": ["runner"], "properties": { "runner": { "const": "codex" } } },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["command"] },
                  { "required": ["agent"] },
                  { "required": ["reasoningEffort"] },
                  { "required": ["contextTier"] },
                  { "required": ["customInstructions"] },
                  { "required": ["allowAll"] },
                  { "required": ["noAskUser"] },
                  { "required": ["pluginDir"] }
                ]
              }
            }
          },
          {
            "if": { "required": ["runner"], "properties": { "runner": { "const": "shell" } } },
            "then": {
              "required": ["command"],
              "not": {
                "anyOf": [
                  { "required": ["agent"] },
                  { "required": ["model"] },
                  { "required": ["reasoningEffort"] },
                  { "required": ["contextTier"] },
                  { "required": ["customInstructions"] },
                  { "required": ["allowAll"] },
                  { "required": ["noAskUser"] },
                  { "required": ["pluginDir"] }
                ]
              }
            }
          }
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lane", "prompt", "validation"],
        "additionalProperties": false,
        "oneOf": [
          { "required": ["repo", "baseRef"] },
          { "required": ["fixture"] }
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "enabled": { "type": "boolean" },
          "repo": { "type": "string" },
          "baseRef": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "fixture": { "type": "string" },
          "installKit": { "type": "boolean" },
          "category": { "type": "string", "enum": ["short-mechanical", "feature", "multi-surface", "longbuild"] },
          "durationClass": { "type": "string", "enum": ["minutes", "hours", "overnight"] },
          "expectedHumanInterventions": { "type": "integer", "minimum": 0 },
          "lane": { "type": "string", "enum": ["ui", "ux", "backend", "full-stack", "infra", "ops", "learning", "yagni", "knowledge", "runtime", "security"] },
          "prompt": { "type": "string", "minLength": 1 },
          "expectedExecution": { "$ref": "#/definitions/executionIntent" },
          "validation": { "type": "array", "items": { "type": "string" } },
          "validationByArm": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "expectedArtifacts": { "type": "array", "items": { "type": "string" } },
          "expectedArtifactsByArm": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "tags": { "type": "array", "items": { "type": "string" } },
          "scoring": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}